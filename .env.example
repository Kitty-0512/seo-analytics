# Database
POSTGRES_DB=seo_analytics
POSTGRES_USER=seo
POSTGRES_PASSWORD=seo123456

# Redis
REDIS_PASSWORD=redis123456

# Google Search Console OAuth
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:8080/api/v1/auth/gsc/callback

# Bing Webmaster (optional default; can also be set per-site in UI)
BING_API_KEY=

# LLM (OpenAI-compatible: Qwen / Ollama / OpenAI)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# Frontend (OAuth redirect target after GSC callback)
FRONTEND_URL=http://localhost

# Render only: Vite build-time API base (e.g. https://seo-api-xxxx.onrender.com/api)
# VITE_API_BASE_URL=
